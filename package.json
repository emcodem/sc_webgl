{
  "name": "sc_webgl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "capture": "node scripts/capture-all.mjs",
    "capture:relay": "node scripts/mouse-capture-server.mjs",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "gen:stars": "node scripts/genBrightStars.mjs",
    "electron:dev": "concurrently -k -n VITE,ELECTRON -c blue,green \"vite\" \"wait-on tcp:5174 && cross-env ELECTRON_START_URL=http://localhost:5174 electron .\"",
    "electron:preview": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "three": "^0.169.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/three": "^0.169.0",
    "concurrently": "^10.0.4",
    "cross-env": "^10.1.0",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "playwright": "^1.61.1",
    "typescript": "^5.6.0",
    "vite": "^7.0.0",
    "vitest": "^2.1.0",
    "wait-on": "^9.1.0",
    "ws": "^8.17.0"
  },
  "build": {
    "appId": "com.emcodem.vector",
    "productName": "Vector",
    "asar": true,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/**/*"
    ],
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "portable"
    },
    "portable": {
      "artifactName": "${productName}-${version}-portable.exe"
    },
    "linux": {
      "target": "AppImage"
    },
    "mac": {
      "target": "dmg"
    }
  }
}
